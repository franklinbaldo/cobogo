{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franklinbaldo.github.io/cobogo/schemas/rendered-evidence-manifest.schema.json",
  "title": "Cobogo Rendered Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "revision", "phase", "route", "responsive", "captures"],
  "properties": {
    "version": { "const": 1 },
    "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "phase": { "enum": ["pull_request", "main"] },
    "head_revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "published_revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "route": { "type": "string", "minLength": 1 },
    "responsive": { "type": "boolean" },
    "method": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["viewport", "artifact"],
        "properties": {
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          },
          "artifact": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
