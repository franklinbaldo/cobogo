---
import '../styles/core.css';
import '../styles/patterns.css';

const github = 'https://github.com/franklinbaldo/cobogo';
const problems = [
  ['Entidade + atributos', 'Apresente quem ou o que está em foco sem misturar identidade com domínio.', 'identity'],
  ['Estado + alerta', 'Dê peso proporcional à situação e preserve significado além da cor.', 'state'],
  ['Leitura longa', 'Organize ritmo, medida, pausas e hierarquia para leitura contínua.', 'flow'],
  ['Ações', 'Deixe a próxima ação visível sem transformar toda a tela em botão.', 'actions'],
  ['Relações', 'Mostre conexão e contraste entre elementos com estrutura, não decoração.', 'grid'],
  ['Coleção densa', 'Ajude a comparar muitos dados sem perder escaneabilidade.', 'data-table'],
  ['Contexto + metadados', 'Separe informação principal, proveniência e inscrição editorial.', 'provenance'],
];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Cobogó — gramática visual brasileira e conhecimento reutilizável para software." />
    <title>Cobogó — gramática visual brasileira para software</title>
  </head>
  <body>
    <a class="skip" href="#conteudo">Ir para o conteúdo</a>

    <header class="site-header">
      <a class="brand" href="/cobogo/" aria-label="Cobogó — início">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span>Cobogó</span>
      </a>
      <nav aria-label="Navegação principal">
        <a href="#gramatica">Gramática</a>
        <a href="#problemas">Problemas</a>
        <a href="#usar">Usar</a>
        <a href={`${github}/tree/main/knowledge`}>Conhecimento</a>
      </nav>
    </header>

    <main id="conteudo">
      <section class="hero" data-cobogo-inverted>
        <div class="hero-copy">
          <p class="eyebrow">Gramática visual brasileira para software</p>
          <h1>Interfaces com<br /><em>estrutura, ritmo</em><br />e identidade.</h1>
          <p class="lede">Cobogó reúne decisões de apresentação que podem ser compartilhadas entre produtos sem apagar o jeito próprio de cada um.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#usar">Começar a usar</a>
            <a class="button button-quiet" href={`${github}`}>Ver no GitHub</a>
          </div>
        </div>

        <div class="hero-composition" aria-label="Composição demonstrando a gramática visual do Cobogó">
          <div class="tile tile-a"><span>hierarquia</span></div>
          <div class="tile tile-b"><span>ritmo</span></div>
          <div class="tile tile-c"><span>contraste</span></div>
          <div class="tile tile-d"><span>relação</span></div>
          <div class="tile tile-e" aria-hidden="true"></div>
          <div class="tile tile-f"><span>estado</span></div>
        </div>
      </section>

      <section class="manifesto" id="gramatica">
        <p class="section-number" aria-hidden="true">01</p>
        <div>
          <p class="eyebrow dark">A ideia</p>
          <h2>Brasilidade é relação,<br />não uma skin.</h2>
        </div>
        <div class="manifesto-copy" data-cobogo-flow>
          <p>O Cobogó não tenta fazer todos os produtos parecerem iguais. Ele compartilha <strong>relações visuais</strong>: como informação principal e secundária convivem, como o espaço cria ritmo, como estados ganham peso e como interfaces densas continuam legíveis.</p>
          <p>O domínio fica no produto. A apresentação que se prova reutilizável volta para o Cobogó como conhecimento, CSS, pattern ou componente comportamental.</p>
        </div>
      </section>

      <section class="demo-band" aria-labelledby="demo-title">
        <div class="demo-heading">
          <p class="eyebrow dark">Uma gramática, usos diferentes</p>
          <h2 id="demo-title">Mesmo parentesco.<br />Outra personalidade.</h2>
        </div>

        <div class="demo-grid" data-cobogo-pattern="grid" style="--cobogo-grid-gap: 1.25rem">
          <article class="demo-card news" style="--cobogo-grid-span: 12; --cobogo-grid-span-md: 7">
            <p class="demo-kicker">Jornalismo local · 05 set 2026</p>
            <h3>Uma manchete pode respirar sem perder densidade.</h3>
            <p>Tipografia editorial, inscrição e proveniência formam um gênero próprio — sem abandonar as mesmas relações de hierarquia.</p>
            <div data-cobogo-pattern="provenance">
              <strong>Fonte primária</strong>
              <span data-cobogo-source>Documento público · atualização verificada</span>
            </div>
          </article>

          <article class="demo-card app" style="--cobogo-grid-span: 12; --cobogo-grid-span-md: 5">
            <p class="demo-kicker">Aplicação</p>
            <div data-cobogo-pattern="identity">
              <div data-cobogo-identity-mark>CG</div>
              <div data-cobogo-identity-body>
                <h3 data-cobogo-identity-name>Causa Ganha</h3>
                <p data-cobogo-identity-meta>Busca e leitura de decisões judiciais</p>
              </div>
            </div>
            <div class="metrics" data-cobogo-pattern="grid" style="--cobogo-grid-columns: 2; --cobogo-grid-gap: 1rem">
              <div data-cobogo-pattern="metric" style="--cobogo-grid-span: 1">
                <span data-cobogo-value>128</span>
                <span data-cobogo-label>resultados</span>
              </div>
              <div data-cobogo-pattern="metric" style="--cobogo-grid-span: 1">
                <span data-cobogo-value>4,2s</span>
                <span data-cobogo-label>consulta</span>
              </div>
            </div>
            <p data-cobogo-pattern="state" data-cobogo-state="success">Dados disponíveis</p>
          </article>
        </div>
      </section>

      <section class="problems" id="problemas">
        <div class="section-intro">
          <p class="section-number" aria-hidden="true">02</p>
          <div>
            <p class="eyebrow dark">Comece pelo problema</p>
            <h2>O que você precisa<br />deixar claro?</h2>
            <p>Você não precisa conhecer o nome de um componente. Escolha a relação visual que precisa resolver e siga para a implementação mais simples.</p>
          </div>
        </div>

        <div class="problem-list">
          {problems.map(([title, copy, pattern], index) => (
            <a class="problem" href={`${github}/blob/main/src/styles/patterns.css`}>
              <span class="problem-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="problem-body"><strong>{title}</strong><span>{copy}</span></span>
              <code>{pattern}</code>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="principles">
        <div class="principle-title">
          <p class="eyebrow">O que fica compartilhado</p>
          <h2>Peças pequenas.<br />Decisões fortes.</h2>
        </div>
        <div class="principle-grid">
          <article><span class="big-number">12</span><h3>colunas quando você precisa de estrutura</h3><p>Grid responsivo como relação visual, não como componente de domínio.</p></article>
          <article><span class="big-number">70ch</span><h3>de medida para leitura confortável</h3><p>Um papel semântico que pode ser retematizado por cada produto.</p></article>
          <article><span class="big-number">4×</span><h3>níveis de ritmo espacial</h3><p>Adjacência, grupo, seção e pausa ajudam a composição a falar.</p></article>
        </div>
      </section>

      <section class="use" id="usar">
        <div class="use-copy">
          <p class="section-number" aria-hidden="true">03</p>
          <div>
            <p class="eyebrow dark">Comece simples</p>
            <h2>HTML semântico.<br />Core. Patterns.</h2>
            <p>Use as fundações quando elas já resolverem a relação. Componentes entram quando existe comportamento, coordenação ou mecânica de acessibilidade que vale compartilhar.</p>
          </div>
        </div>

        <div class="code-card" data-cobogo-inverted>
          <div class="code-top"><span>CSS</span><a href={`${github}/tree/main/src/styles`}>ver fontes ↗</a></div>
          <pre><code><span class="code-dim">/* fundações semânticas */</span>
@import "cobogo/core";

<span class="code-dim">/* relações visuais */</span>
@import "cobogo/patterns";</code></pre>
          <div class="code-note"><span data-cobogo-pattern="state" data-cobogo-state="success">Framework-neutral</span><span>Astro é a recomendação atual para novos sites.</span></div>
        </div>
      </section>

      <section class="closing" data-cobogo-inverted>
        <p class="eyebrow">Design system vivo</p>
        <h2>Use. Observe.<br /><em>Aprenda de volta.</em></h2>
        <p>Quando um projeto encontra uma solução melhor, o Cobogó muda junto. O objetivo não é congelar uma biblioteca — é acumular conhecimento e simplificar sua forma.</p>
        <div class="hero-actions">
          <a class="button button-primary light" href={`${github}/tree/main/knowledge`}>Explorar conhecimento</a>
          <a class="button button-quiet light" href={`${github}/blob/main/docs/rfcs/0003-simplify-design-system.md`}>Ler a direção atual</a>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand footer-brand" href="/cobogo/"><span class="brand-mark small" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>Cobogó</span></a>
      <p>Gramática visual brasileira + conhecimento reutilizável.</p>
      <a href={github}>GitHub ↗</a>
    </footer>
  </body>
</html>

<style>
  :global(:root) { --ink:#17221f; --paper:#f4f0e6; --paper-2:#e7dfce; --lime:#d5f03f; --coral:#ed654b; --blue:#235f77; --cobogo-canvas:var(--paper); --cobogo-text:var(--ink); --cobogo-text-muted:#5d625c; --cobogo-border:#bdb5a5; --cobogo-accent:#174d61; --cobogo-surface:#fffdf8; --cobogo-surface-muted:var(--paper-2); --cobogo-radius-surface:0; --cobogo-radius-control:0; --cobogo-font-display:"Arial Narrow","Helvetica Neue",Arial,sans-serif; --cobogo-font-body:"Helvetica Neue",Arial,sans-serif; --cobogo-font-inscription:"Helvetica Neue",Arial,sans-serif; }
  :global(*){box-sizing:border-box} :global(html){scroll-behavior:smooth} :global(body){overflow-x:hidden} :global(a){color:inherit} :global(strong){font-weight:750}
  .skip{position:fixed;top:.75rem;left:.75rem;z-index:100;transform:translateY(-150%);background:var(--lime);color:var(--ink);padding:.7rem 1rem;font-weight:700}.skip:focus{transform:translateY(0)}
  .site-header{min-height:5rem;display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1rem clamp(1.25rem,4vw,4rem);border-bottom:1px solid var(--ink);background:var(--paper)}
  .brand{display:inline-flex;align-items:center;gap:.75rem;text-decoration:none;font-weight:800;font-size:1.1rem}.brand-mark{width:2.2rem;aspect-ratio:1;display:grid;grid-template-columns:1fr 1fr;gap:2px;rotate:45deg}.brand-mark i{display:block;border:3px solid currentColor;border-radius:50% 50% 0 50%}.brand-mark.small{width:1.6rem}
  nav{display:flex;gap:clamp(.9rem,2.5vw,2.4rem);align-items:center;font-size:.86rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em}nav a{text-decoration:none;border-bottom:2px solid transparent}nav a:hover{border-color:currentColor}
  .hero{min-height:46rem;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(24rem,.95fr);background:var(--ink);color:var(--paper);overflow:hidden}.hero-copy{min-width:0;padding:clamp(4rem,9vw,9rem) clamp(1.25rem,5vw,5rem);display:flex;flex-direction:column;justify-content:center;align-items:flex-start}
  .eyebrow{margin:0 0 1.5rem;font-size:.74rem;line-height:1.2;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--lime)}.eyebrow.dark{color:var(--blue)}
  .hero h1{margin:0;color:inherit;font-size:clamp(3.8rem,8.7vw,8.8rem);line-height:.82;letter-spacing:-.065em;font-weight:900;text-transform:uppercase}.hero h1 em,.closing h2 em{color:var(--lime);font-style:normal}.lede{margin:2.5rem 0 0;max-width:40rem;font-size:clamp(1.15rem,1.8vw,1.55rem);line-height:1.45;color:#d8d5cb}.hero-actions{margin-top:2.25rem;display:flex;flex-wrap:wrap;gap:.8rem}
  .button{display:inline-flex;min-height:3.2rem;align-items:center;justify-content:center;padding:.75rem 1.15rem;border:1px solid currentColor;text-decoration:none;font-size:.82rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase}.button-primary{background:var(--lime);color:var(--ink);border-color:var(--lime)}.button-quiet{color:var(--paper)}.button.light{color:var(--ink)}.button-quiet.light{color:var(--paper)}
  .hero-composition{min-height:46rem;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));grid-template-rows:repeat(8,minmax(0,1fr));background:var(--paper-2);border-left:1px solid var(--paper)}
  .tile{position:relative;min-width:0;display:flex;align-items:flex-end;padding:1rem;border:1px solid var(--ink);color:var(--ink);overflow:hidden;font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.tile::before{content:'';position:absolute;inset:14%;border:.85rem solid currentColor;border-radius:50% 50% 0 50%;rotate:45deg;opacity:.92}.tile span{position:relative;z-index:1;min-width:0;overflow-wrap:anywhere;background:inherit;padding:.25rem}.tile-a{grid-column:1/4;grid-row:1/4;background:var(--lime)}.tile-b{grid-column:4/7;grid-row:1/6;background:var(--coral)}.tile-b::before{border-radius:50%;border-width:1.5rem}.tile-c{grid-column:1/3;grid-row:4/9;background:var(--blue);color:white}.tile-c::before{border-radius:0;rotate:0deg;inset:20% 30%}.tile-d{grid-column:3/5;grid-row:4/7;background:var(--paper)}.tile-d::before{border-radius:50% 50% 0 0;rotate:0deg}.tile-e{grid-column:5/7;grid-row:6/9;background:var(--lime)}.tile-e::before{inset:-15% 15% 15% -15%;border-width:2rem;border-radius:50%}.tile-f{grid-column:3/5;grid-row:7/9;background:var(--ink);color:var(--paper)}.tile-f::before{display:none}
  .manifesto{padding:clamp(5rem,10vw,10rem) clamp(1.25rem,4vw,4rem);display:grid;grid-template-columns:5rem minmax(0,1fr) minmax(18rem,.7fr);gap:clamp(2rem,5vw,6rem);align-items:start}.section-number{margin:0;font-family:var(--cobogo-font-data);font-size:.8rem;color:var(--cobogo-text-muted)}
  .manifesto h2,.demo-heading h2,.section-intro h2,.principle-title h2,.use h2{margin:0;font-size:clamp(3rem,6vw,6.3rem);line-height:.9;letter-spacing:-.055em;text-transform:uppercase}.manifesto-copy{padding-top:2.5rem}.manifesto-copy p{margin:0;font-size:1.08rem}
  .demo-band{background:var(--paper-2);border-block:1px solid var(--ink);padding:clamp(4rem,8vw,7rem) clamp(1.25rem,4vw,4rem)}.demo-heading{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-bottom:3rem}.demo-card{min-height:28rem;padding:clamp(1.5rem,3vw,3rem);border:1px solid var(--ink);background:var(--paper);display:flex;flex-direction:column}.demo-card.news{background:#fffdf8}.demo-card.news h3{max-width:11ch;margin:1rem 0;font-family:Georgia,serif;font-size:clamp(2.5rem,5vw,5.7rem);line-height:.94;font-weight:500;letter-spacing:-.05em}.demo-card.news>p:not(.demo-kicker){margin-block:auto 2rem;font-family:Georgia,serif;font-size:1.05rem}.demo-kicker{margin:0;font-size:.74rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.demo-card.app{background:#e9eef0}.demo-card.app>[data-cobogo-pattern="identity"]{margin-top:2rem}.metrics{margin-block:auto 2rem}.demo-card.app>[data-cobogo-pattern="state"]{align-self:flex-start}
  .problems{padding:clamp(5rem,10vw,10rem) clamp(1.25rem,4vw,4rem)}.section-intro{display:grid;grid-template-columns:5rem minmax(0,1fr);gap:clamp(2rem,5vw,6rem);margin-bottom:4rem}.section-intro p:not(.eyebrow){margin-top:1.5rem;max-width:42rem;font-size:1.05rem}.problem-list{border-top:1px solid var(--ink)}.problem{display:grid;grid-template-columns:4rem minmax(0,1fr) auto 2rem;gap:1rem;align-items:center;padding:1.3rem 0;border-bottom:1px solid var(--ink);text-decoration:none;transition:padding var(--cobogo-motion-state),background var(--cobogo-motion-state)}.problem:hover{padding-inline:.75rem;background:var(--lime)}.problem-index{font-family:var(--cobogo-font-data);font-size:.78rem}.problem-body{display:grid;grid-template-columns:minmax(12rem,.5fr) minmax(18rem,1fr);gap:2rem;align-items:baseline}.problem-body strong{font-size:clamp(1.25rem,2vw,2rem)}.problem-body>span{color:var(--cobogo-text-muted)}.problem code{font-size:.72rem;background:var(--paper-2);padding:.3rem .5rem}.arrow{font-size:1.3rem}
  .principles{background:var(--blue);color:white;padding:clamp(5rem,9vw,9rem) clamp(1.25rem,4vw,4rem)}.principle-title h2{color:white;max-width:12ch}.principle-title .eyebrow{color:var(--lime)}.principle-grid{margin-top:5rem;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgb(255 255 255/.55)}.principle-grid article{padding:2.5rem 2rem 0 0;min-height:18rem;border-right:1px solid rgb(255 255 255/.55)}.principle-grid article+article{padding-left:2rem}.principle-grid article:last-child{border:0}.big-number{display:block;font-size:clamp(3.5rem,7vw,7rem);line-height:.85;color:var(--lime);font-weight:900;letter-spacing:-.06em}.principle-grid h3{color:white;max-width:16ch;font-size:1.35rem;margin:2rem 0 .75rem}.principle-grid p{color:#d9e1e3;font-size:.9rem}
  .use{padding:clamp(5rem,10vw,10rem) clamp(1.25rem,4vw,4rem);display:grid;grid-template-columns:1fr minmax(24rem,.85fr);gap:clamp(3rem,8vw,9rem);align-items:center}.use-copy{display:grid;grid-template-columns:4rem minmax(0,1fr);gap:2rem}.use-copy>div>p:last-child{margin-top:1.5rem;font-size:1.05rem}.code-card{min-width:0;background:var(--ink);color:var(--paper);border:1px solid var(--ink)}.code-top{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 1rem;border-bottom:1px solid #53605c;font-family:var(--cobogo-font-data);font-size:.72rem;text-transform:uppercase}.code-top a{color:var(--lime)}pre{margin:0;max-width:100%;padding:clamp(1.5rem,4vw,3rem);overflow:auto;font-size:clamp(.85rem,1.5vw,1.08rem);line-height:1.8}.code-dim{color:#82908a}.code-note{display:flex;flex-wrap:wrap;gap:1rem 2rem;justify-content:space-between;padding:1rem;border-top:1px solid #53605c;color:#cbd2cf;font-size:.78rem}.code-note [data-cobogo-state="success"]{color:var(--lime)}
  .closing{min-height:38rem;padding:clamp(5rem,10vw,10rem) clamp(1.25rem,5vw,5rem);background:var(--ink);color:var(--paper);display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.closing h2{margin:0;color:inherit;font-size:clamp(4rem,9vw,9rem);line-height:.84;letter-spacing:-.065em;text-transform:uppercase}.closing>p:not(.eyebrow){margin-top:2.5rem;max-width:45rem;color:#d8d5cb;font-size:1.12rem}
  footer{padding:2rem clamp(1.25rem,4vw,4rem);display:grid;grid-template-columns:1fr 1fr auto;gap:2rem;align-items:center;border-top:1px solid var(--ink);font-size:.82rem}footer p{margin:0;color:var(--cobogo-text-muted)}footer>a:last-child{font-weight:700}
  @media(max-width:900px){.site-header{align-items:flex-start}nav{flex-wrap:wrap;justify-content:flex-end}.hero{grid-template-columns:1fr}.hero-composition{min-height:34rem;border-left:0;border-top:1px solid var(--paper)}.manifesto{grid-template-columns:3rem 1fr}.manifesto-copy{grid-column:2;padding-top:0}.demo-heading{grid-template-columns:1fr}.problem-body{grid-template-columns:1fr;gap:.35rem}.principle-grid{grid-template-columns:1fr}.principle-grid article,.principle-grid article+article{min-height:auto;padding:2rem 0;border-right:0;border-bottom:1px solid rgb(255 255 255/.55)}.use{grid-template-columns:1fr}footer{grid-template-columns:1fr auto}footer p{grid-row:2;grid-column:1/-1}}
  @media(max-width:620px){.site-header{min-height:auto;display:grid;gap:1rem}nav{justify-content:flex-start;gap:.8rem 1.1rem}nav a:nth-child(4){display:none}.hero{min-height:0}.hero-copy{padding-block:4.5rem}.hero h1{font-size:clamp(3.2rem,15vw,4.8rem);overflow-wrap:anywhere}.hero-composition{min-height:26rem}.manifesto,.section-intro{grid-template-columns:1fr;gap:1.25rem}.manifesto-copy{grid-column:1}.section-number{border-top:1px solid currentColor;padding-top:.5rem}.demo-card{min-height:24rem}.problem{grid-template-columns:2.4rem minmax(0,1fr) 1.5rem}.problem code{display:none}.problem-body>span{font-size:.87rem}.use-copy{grid-template-columns:1fr}.closing h2{font-size:clamp(3.4rem,15vw,5.2rem);overflow-wrap:anywhere}footer{grid-template-columns:1fr}footer p,footer>a:last-child{grid-column:1;grid-row:auto}}
  @media(prefers-reduced-motion:reduce){.problem{transition:none}}
</style>
