---
import GreenfieldLayout from '../../../layouts/GreenfieldLayout.astro';
import { patternEntries } from '../../../lib/knowledgeProjection';
---

<GreenfieldLayout title="COBOGÓ — Patterns">
  <main id="conteudo" class="gf-section">
    <p class="gf-kicker">Referência · patterns tipados</p>
    <h1>Patterns</h1>
    <p>
      Patterns entram aqui quando existe evidência reutilizável suficiente para nomear uma relação.
      Status vem do corpus canônico; esta superfície não promove experimental a stable por conta própria.
    </p>

    <section data-cobogo-pause aria-labelledby="patterns-list-title">
      <h2 id="patterns-list-title">Patterns registrados</h2>
      <div class="gf-reference-list">
        {patternEntries.map((entry) => (
          <article class="gf-reference-row">
            <div>
              <span class="gf-inscription">{entry.type}</span>
              <h3>{entry.title}</h3>
            </div>
            <div>
              {entry.status && <span class="gf-status">{entry.status}</span>}
              {' '}
              <a href={`https://github.com/franklinbaldo/cobogo/blob/main${entry.path}`}>fonte ↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <p><a href="/cobogo/next/">← voltar à orientação</a></p>
  </main>
</GreenfieldLayout>
