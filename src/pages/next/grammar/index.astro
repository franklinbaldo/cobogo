---
import GreenfieldLayout from '../../../layouts/GreenfieldLayout.astro';
import { canonEntries, grammarEntries } from '../../../lib/knowledgeProjection';
---

<GreenfieldLayout title="COBOGÓ — Gramática">
  <main id="conteudo" class="gf-section">
    <p class="gf-kicker">Referência · projeção do corpus OKF</p>
    <h1>Gramática</h1>
    <p>
      Esta página não reescreve o canon em Astro. Ela projeta os arquivos canônicos de
      <code>knowledge/</code> e mantém o corpus como autoridade.
    </p>

    <section data-cobogo-pause aria-labelledby="canon-title">
      <h2 id="canon-title">Canon</h2>
      <div class="gf-reference-list">
        {canonEntries.map((entry) => (
          <article class="gf-reference-row">
            <div>
              <span class="gf-inscription">canon-rule</span>
              <h3>{entry.title}</h3>
            </div>
            <a href={`https://github.com/franklinbaldo/cobogo/blob/main${entry.path}`}>fonte canônica ↗</a>
          </article>
        ))}
      </div>
    </section>

    <section data-cobogo-pause aria-labelledby="grammar-title">
      <h2 id="grammar-title">Operações de gramática</h2>
      <div class="gf-reference-list">
        {grammarEntries.map((entry) => (
          <article class="gf-reference-row">
            <div>
              <span class="gf-inscription">design-grammar</span>
              <h3>{entry.title}</h3>
            </div>
            <a href={`https://github.com/franklinbaldo/cobogo/blob/main${entry.path}`}>fonte canônica ↗</a>
          </article>
        ))}
      </div>
    </section>

    <p><a href="/cobogo/next/">← voltar à orientação</a></p>
  </main>
</GreenfieldLayout>
