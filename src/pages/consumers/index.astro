---
import GreenfieldLayout from '../../layouts/GreenfieldLayout.astro';
import { consumerEntries } from '../../lib/knowledgeProjection';
---

<GreenfieldLayout title="COBOGÓ — Consumers">
  <main id="conteudo" class="gf-section">
    <p class="gf-kicker">Referência · projeção do registry</p>
    <h1>Consumers</h1>
    <p>O registry é evidência operacional. Esta página lista apenas conceitos com <code>type: consumer</code>; status vem do frontmatter canônico.</p>
    <section data-cobogo-pause aria-labelledby="registry-title">
      <h2 id="registry-title">Registry atual</h2>
      <div class="gf-reference-list">
        {consumerEntries.map((entry) => <article class="gf-reference-row"><div><span class="gf-inscription">consumer</span><h3>{entry.title}</h3></div><div>{entry.status && <span class="gf-status">{entry.status}</span>} {' '}<a href={`https://github.com/franklinbaldo/cobogo/blob/main${entry.path}`}>evidência ↗</a></div></article>)}
      </div>
    </section>
    <p><a href="/cobogo/">← voltar à orientação</a></p>
  </main>
</GreenfieldLayout>
