---
import '../styles/index.css'
import { css } from '../../styled-system/css'
import { button, badge, navLink } from '../../styled-system/recipes'
import RelationCollection from '../components/RelationCollection.astro'
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Veja como a mesma hierarquia de ações assume vozes visuais diferentes com Cobogó." />
    <title>Ações — Cobogó</title>
  </head>
  <body>
    <header class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, minH: '20', display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: '6', borderBottom: '1px solid', borderColor: 'border' })}>
      <a href="/cobogo/" class={css({ fontWeight: 'black', fontSize: 'xl', textDecoration: 'none', letterSpacing: '-0.04em' })}>COBOGÓ</a>
      <nav class={css({ display: 'flex', gap: { base: '4', md: '8' }, flexWrap: 'wrap', justifyContent: 'end' })} aria-label="Principal">
        <a class={navLink()} href="/cobogo/">Início</a>
        <a class={navLink()} href="/cobogo/comece/">Comece</a>
        <a class={navLink()} href="/cobogo/problemas/">Problemas</a>
      </nav>
    </header>

    <main>
      <section class={css({ background: 'attention', borderBottom: '1px solid', borderColor: 'text' })}>
        <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '16', md: '24' }, display: 'grid', gridTemplateColumns: { base: '1fr', md: '0.65fr 1.35fr' }, gap: '10', alignItems: 'end' })}>
          <p class={css({ textStyle: 'eyebrow', m: '0' })}>Relação · ação</p>
          <div>
            <h1 class={css({ textStyle: 'display', m: '0', maxW: '10ch' })}>A prioridade fica. A voz muda.</h1>
            <p class={css({ fontSize: 'lg', lineHeight: 'body', maxW: '48rem', mt: '7' })}>Cobogó pode compartilhar qual caminho é principal e qual é secundário sem impor uma aparência universal de botão.</p>
          </div>
        </div>
      </section>

      <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '14', md: '20' } })}>
        <div class={css({ display: 'flex', justifyContent: 'space-between', alignItems: 'end', gap: '6', flexWrap: 'wrap', mb: '10' })}>
          <div>
            <p class={css({ textStyle: 'eyebrow', color: 'info', mb: '3' })}>Mesma relação</p>
            <h2 class={css({ textStyle: 'title', m: '0', maxW: '17ch' })}>Continuar primeiro. Detalhes depois.</h2>
          </div>
          <span class={badge({ tone: 'accent' })}>principal → secundária</span>
        </div>

        <div class={css({ display: 'grid', gridTemplateColumns: { base: '1fr', lg: '1fr 1fr' }, gap: '4' })}>
          <article class={css({ background: 'surfaceMuted', border: '1px solid', borderColor: 'text', minH: '22rem', p: { base: '6', md: '8' }, display: 'flex', flexDirection: 'column', justifyContent: 'space-between' })}>
            <div>
              <p class={css({ textStyle: 'eyebrow', color: 'info', mt: '0' })}>Operacional</p>
              <h3 class={css({ fontSize: '2xl', lineHeight: 'tight', m: '0', textTransform: 'uppercase', letterSpacing: '-0.03em' })}>Confirme os dados</h3>
              <p class={css({ color: 'textMuted', lineHeight: 'body', maxW: '30rem' })}>Uma tarefa curta, objetiva, com pouco ruído.</p>
            </div>
            <div class={css({ display: 'flex', alignItems: 'center', gap: '4', flexWrap: 'wrap' })}>
              <button class={button({ visual: 'dark' })}>Continuar</button>
              <a href="#codigo" class={css({ fontWeight: 'bold', color: 'text' })}>Ver detalhes</a>
            </div>
          </article>

          <article class={css({ background: 'info', color: 'canvas', border: '1px solid', borderColor: 'text', minH: '22rem', p: { base: '6', md: '8' }, display: 'flex', flexDirection: 'column', justifyContent: 'space-between' })}>
            <div>
              <p class={css({ fontFamily: 'serif', fontStyle: 'italic', mt: '0', color: 'attention' })}>Caderno cultural</p>
              <h3 class={css({ fontFamily: 'serif', fontStyle: 'italic', fontWeight: 'medium', fontSize: { base: '3xl', md: '4xl' }, lineHeight: 'tight', m: '0' })}>Continue a leitura</h3>
              <p class={css({ color: 'surfaceMuted', lineHeight: 'body', maxW: '30rem' })}>A mesma prioridade, agora com uma presença editorial mais aberta.</p>
            </div>
            <div class={css({ display: 'flex', alignItems: 'center', gap: '5', flexWrap: 'wrap' })}>
              <button class={css({ border: '1px solid', borderColor: 'attention', background: 'attention', color: 'text', px: '6', py: '3', fontFamily: 'serif', fontStyle: 'italic', fontSize: 'lg', cursor: 'pointer' })}>Continuar</button>
              <a href="#codigo" class={css({ color: 'canvas', textUnderlineOffset: '4px' })}>Ver detalhes</a>
            </div>
          </article>
        </div>
      </section>

      <section id="codigo" class={css({ background: 'text', color: 'canvas' })}>
        <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '14', md: '20' }, display: 'grid', gridTemplateColumns: { base: '1fr', lg: '0.75fr 1.25fr' }, gap: '10', alignItems: 'start' })}>
          <div>
            <p class={css({ textStyle: 'eyebrow', color: 'accent', mb: '3' })}>Fronteira</p>
            <h2 class={css({ textStyle: 'title', color: 'canvas', m: '0', maxW: '13ch' })}>Compartilhe a prioridade. Personalize a presença.</h2>
            <p class={css({ color: 'surfaceMuted', lineHeight: 'body', maxW: '34rem', mt: '5' })}>O contrato pode ser pequeno: uma ação principal e um caminho secundário. O tratamento visual continua local ao produto.</p>
          </div>
          <pre class={css({ m: '0', p: { base: '5', md: '6' }, maxW: '100%', minW: '0', overflowX: 'auto', background: 'canvas', color: 'text', fontSize: 'sm', lineHeight: 'body' })}><code>{`<button>Continuar</button>\n<a href="/detalhes">Ver detalhes</a>`}</code></pre>
        </div>
      </section>

      <RelationCollection current="acoes" />
    </main>
  </body>
</html>