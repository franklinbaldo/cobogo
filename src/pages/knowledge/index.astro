---
import GreenfieldLayout from '../../layouts/GreenfieldLayout.astro';
import { knowledgeEntries } from '../../lib/knowledgeProjection';

const groups = Object.entries(
  knowledgeEntries.reduce<Record<string, typeof knowledgeEntries>>((acc, entry) => {
    (acc[entry.type] ??= []).push(entry);
    return acc;
  }, {}),
).sort(([a], [b]) => a.localeCompare(b));
---

<GreenfieldLayout title="COBOGÓ — Knowledge">
  <main id="conteudo" class="gf-section">
    <p class="gf-kicker">Explorer · corpus OKF tipado</p>
    <h1>Knowledge</h1>
    <p>Este índice projeta apenas conceitos com <code>type</code> explícito. Diretório não é ontologia.</p>

    <section data-cobogo-pause aria-labelledby="summary-title">
      <h2 id="summary-title">{knowledgeEntries.length} conceitos tipados</h2>
      <div class="gf-role-map">
        {groups.map(([type, entries]) => <div class="gf-role"><code>{type}</code><span>{entries.length} {entries.length === 1 ? 'conceito' : 'conceitos'}</span></div>)}
      </div>
    </section>

    <section data-cobogo-pause aria-labelledby="pipeline-title">
      <p class="gf-inscription">Por trás da superfície</p>
      <h2 id="pipeline-title">O corpus é verificável antes de virar página.</h2>
      <p>
        O conteúdo em <code>knowledge/</code> continua sendo a autoridade canônica. No CI, o mesmo bundle
        é validado com <code>okf-parser</code> v0.42.8, incluindo classificação, type specs normativos e
        relações declaradas. Depois da validação, o projeto deriva inventário com digests, grafo,
        schema inferido e uma base DuckDB para inspeção. Essas saídas são projeções descartáveis,
        não uma segunda fonte de verdade.
      </p>
      <p>
        <a href="https://github.com/franklinbaldo/cobogo/actions/workflows/knowledge.yml">Ver o workflow Knowledge no GitHub ↗</a>
      </p>
    </section>

    <section data-cobogo-pause aria-labelledby="reuse-title">
      <p class="gf-inscription">Levar o corpus</p>
      <h2 id="reuse-title">As mesmas projeções podem ser reproduzidas fora do site.</h2>
      <p>
        Clone o repositório e use o parser fixado pelo próprio projeto. Assim dá para consultar o
        conhecimento como Markdown tipado, inventário, relações ou DuckDB sem depender desta interface.
      </p>
      <pre class="gf-code-block" tabindex="0" aria-label="Comandos para reproduzir o corpus do Cobogó"><code>uvx --from okf-parser==0.42.8 okf-parser check knowledge --classify --relational-schema okf.schema.sql
uvx --from okf-parser==0.42.8 okf-parser inventory knowledge --digests
uvx --from okf-parser==0.42.8 okf-parser graph knowledge
uvx --from okf-parser==0.42.8 okf-parser duckdb knowledge knowledge.duckdb</code></pre>
      <p>
        <a href="https://github.com/franklinbaldo/cobogo">Abrir o repositório e o corpus-fonte ↗</a>
      </p>
    </section>

    {groups.map(([type, entries]) => (
      <section data-cobogo-pause aria-labelledby={`type-${type}`}>
        <h2 id={`type-${type}`}>{type}</h2>
        <div class="gf-reference-list">
          {entries.map((entry) => <article class="gf-reference-row"><div><span class="gf-inscription">{entry.type}</span><h3>{entry.title}</h3></div><div>{entry.status && <span class="gf-status">{entry.status}</span>} {' '}<a href={`https://github.com/franklinbaldo/cobogo/blob/main${entry.path}`}>fonte ↗</a></div></article>)}
        </div>
      </section>
    ))}
    <p><a href="/cobogo/">← voltar à orientação</a></p>
  </main>
</GreenfieldLayout>
